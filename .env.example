# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Every variable is optional except OPENROUTER_API_KEY (needed to answer questions)
# and, for docker compose, POSTGRES_PASSWORD.

# --- LLM (OpenRouter or any OpenAI-compatible endpoint) -----------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct   # any id from https://openrouter.ai/models
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

# --- Runtime ------------------------------------------------------------------------------------
# APP_ENV=development            # development | production (production enforces PostgreSQL, hides /api/docs)
# LOG_LEVEL=INFO
# LOG_JSON=true
# CORS_ORIGINS=                  # comma-separated; empty = same-origin only (the bundled UI needs nothing)
# TRUST_PROXY_HEADERS=false      # true only behind a reverse proxy that sets X-Forwarded-For

# --- Database -----------------------------------------------------------------------------------
# Local default: SQLite at ./data/app.db. Production: PostgreSQL with pgvector.
# DATABASE_URL=postgresql+psycopg://ragbot:CHANGE_ME@localhost:5432/ragbot
# AUTO_MIGRATE=true

# docker compose only:
POSTGRES_PASSWORD=
# POSTGRES_USER=ragbot
# POSTGRES_DB=ragbot

# --- Auth & limits ------------------------------------------------------------------------------
# ALLOW_REGISTRATION=true
# ACCESS_TOKEN_TTL_HOURS=24
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_CHAT_PER_MINUTE=20
# RATE_LIMIT_UPLOAD_PER_MINUTE=10

# --- Uploads & ingestion ------------------------------------------------------------------------
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_MB=20
# MAX_FILES_PER_UPLOAD=10
# MAX_PDF_PAGES=500
# CHUNK_SIZE_WORDS=180
# CHUNK_OVERLAP_WORDS=30
# INGESTION_WORKERS=1

# --- Embeddings & retrieval ---------------------------------------------------------------------
# Changing the model requires a fresh database (the app refuses to mix vector spaces).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.20       # calibrated for MiniLM; re-calibrate if you change the model
# RETRIEVAL_STRONG_SCORE=0.55

# --- Agent limits -------------------------------------------------------------------------------
# AGENT_MAX_ITERATIONS=4
# AGENT_MAX_TOOL_CALLS=4
# AGENT_TIMEOUT_SECONDS=90
# AGENT_TOKEN_BUDGET=12000
